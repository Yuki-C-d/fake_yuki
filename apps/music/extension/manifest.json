{
  "manifest_version": 3,
  "name": "Yuki 的小曲",
  "short_name": "小曲",
  "version": "1.0",
  "description": "fake_yuki 音乐站迷你播放器 — 随时控制你的音乐",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yuki 的小曲",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://music.fake-star.xyz/*"],
    "js": ["content.js"]
  }],
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://music.fake-star.xyz/*"]
}
